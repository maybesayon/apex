# Copy to `.env` and fill in what you need. Everything here is optional —
# the app runs with no keys at all.

# ── Market data ───────────────────────────────
# Without this, live quotes fall back to yfinance.
FINNHUB_API_KEY=

# ── Assistant ─────────────────────────────────
# Without this, the assistant uses a built-in offline analyzer.
ANTHROPIC_API_KEY=

# ── TradingView alert webhook ─────────────────
# REQUIRED if you expose POST /webhooks/tradingview to the internet.
# With no secret set, the endpoint accepts anything from anyone.
TRADINGVIEW_WEBHOOK_SECRET=

# ── Email alerts ──────────────────────────────
# Use a Gmail App Password, never your account password:
# https://myaccount.google.com/apppasswords
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Storage ───────────────────────────────────
# SQLite by default. Point DATABASE_URL at Postgres for any deployment with
# an ephemeral filesystem, or every account is lost on restart:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/apex
# Requires: pip install 'psycopg[binary]'
DATABASE_URL=
APEX_DB_PATH=

# ── Sessions ──────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, development generates a key in .apex_dev_secret (gitignored).
APEX_SECRET_KEY=

# production | development. Production refuses to start without a secret
# key and warns if cookies are not Secure.
APEX_ENV=development

# Cookie policy. Keep SameSite=lax when the frontend proxies to the API on
# one origin (Next.js rewrites). Cross-origin needs none + secure + HTTPS.
APEX_COOKIE_SAMESITE=lax
APEX_COOKIE_SECURE=false
APEX_COOKIE_DOMAIN=

# ── API ───────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
# Defaults to localhost:3000 for the Next.js dev server.
APEX_CORS_ORIGINS=http://localhost:3000
